# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
IS_DOCKER=false


BOOKING_REF_PREFIX=

# URLs
# FRONTEND_URL is a SINGLE origin. It is concatenated into Paystack callbacks,
# Pesapal redirects and email links, so a comma-separated list here produces
# malformed URLs. For multiple trusted origins use TRUSTED_ORIGINS below.
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Origins better-auth accepts as an OAuth callbackURL / redirect target.
# Comma-separated; falls back to FRONTEND_URL when unset. Set both apex and www
# (and any preview URL) here during a domain migration.
TRUSTED_ORIGINS=http://localhost:3001


# Database Configuration
#
# PostgreSQL 15 or newer is required, not merely recommended. Migration 0007
# uses the column-scoped `ON DELETE SET NULL (category_id)` form, which older
# servers reject outright -- the deploy fails partway through the migration
# run rather than at startup. Local dev and CI both run 16.
DATABASE_URL=
DOCKER_DATABASE_URL=

REDIS_URL=
DOCKER_REDIS_URL=

# Arcjet
ARCJET_ENV=
ARCJET_KEY=

#Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


SESSION_SECRET=

#Imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

#M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke


# Paystack
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox 
APP_URL=http://api.localhost:3001

# Sentry
SENTRY_DSN=

#Resend
RESEND_API_KEY=

# Email settings
FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=footlooseadventures2026@gmail.com
ADMIN_EMAIL=footlooseadventures2026@gmail.com


# Browser CORS preflight allowlist only (config/cors.config.js). Comma-separated.
# Largely vestigial now that the frontend proxies /api/* server-side.
ALLOWED_ORIGINS=http://localhost:3001


//if you add a required var here, add it to .github/workflows/test.yml too
# Chat proxy upstream (workflow webhook)
CHAT_WEBHOOK_URL=https://your-n8n-host/webhook/safari-chat
CHAT_TIMEOUT_MS=15000

# Set true ONLY when deployed behind Vercel, whose ingress overwrites
# x-vercel-forwarded-for. Anywhere else the header is caller-controlled.
TRUST_VERCEL_FORWARDED_FOR=false

# Number of proxies in front of this process that overwrite x-forwarded-for.
# 0 (the default) means the API is reached directly, and it replaces the
# forwarded headers with the socket address so a caller cannot choose their own
# rate-limit bucket. Set to 1 behind Cloudflare, nginx, Vercel or the Caddy
# front in docker-compose.prod.yml, which sets it to 1 for you.
TRUSTED_PROXY_HOPS=0

# The public hostname clients reach the API at, e.g. api.example.com. Required
# by docker-compose.prod.yml only: Caddy requests a Let's Encrypt certificate
# for exactly this name, so it must have a public A/AAAA record pointing at the
# host and ports 80 and 443 reachable (the ACME challenge is answered on :80).
# Host only — no scheme, no path, no port.
API_PUBLIC_HOST=

# The operator a request belongs to when the hostname does not name one, which
# with TENANT_HOST_SUFFIX unset is every request. Defaults to the row migration
# 0007 seeds; override only if that row was recreated with a different id.
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001

# The domain tenant subdomains live under, e.g. tourops.app — a request to
# acme.tourops.app then resolves to the operator whose slug is `acme`.
#
# LEAVE THIS UNSET for a single-operator deployment. Unset means every request
# resolves to SEED_TENANT_ID without a database lookup, which is how this
# behaved before subdomain routing existed. It is opt-in because "first label
# of the hostname" is not safe on its own: it reads `api` out of
# api.footlooseadventures.com and would hand that request to whichever operator
# registered that slug.
#
# api, www, app, admin, staging and dashboard are reserved and always resolve
# to the default operator. A host under the suffix that names no active
# operator is answered 404, never the default one.
TENANT_HOST_SUFFIX=

# Production database TLS is verified by default. Set true ONLY as a temporary
# escape hatch for a private CA that cannot be supplied via NODE_EXTRA_CA_CERTS.
DB_SSL_NO_VERIFY=false
