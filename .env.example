# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
IS_DOCKER=false


BOOKING_REF_PREFIX=

# URLs
# FRONTEND_URL is a SINGLE origin. It is concatenated into Paystack callbacks,
# Pesapal redirects and email links, so a comma-separated list here produces
# malformed URLs. For multiple trusted origins use TRUSTED_ORIGINS below.
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Origins better-auth accepts as an OAuth callbackURL / redirect target.
# Comma-separated; falls back to FRONTEND_URL when unset. Set both apex and www
# (and any preview URL) here during a domain migration.
TRUSTED_ORIGINS=http://localhost:3001


# Database Configuration
DATABASE_URL=
DOCKER_DATABASE_URL=

REDIS_URL=
DOCKER_REDIS_URL=

# Arcjet
ARCJET_ENV=
ARCJET_KEY=

#Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


SESSION_SECRET=

#Imagekit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

#M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke


# Paystack
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox 
APP_URL=http://api.localhost:3001

# Sentry
SENTRY_DSN=

#Resend
RESEND_API_KEY=

# Email settings
FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=footlooseadventures2026@gmail.com
ADMIN_EMAIL=footlooseadventures2026@gmail.com


# Browser CORS preflight allowlist only (config/cors.config.js). Comma-separated.
# Largely vestigial now that the frontend proxies /api/* server-side.
ALLOWED_ORIGINS=http://localhost:3001


//if you add a required var here, add it to .github/workflows/test.yml too
# Chat proxy upstream (workflow webhook)
CHAT_WEBHOOK_URL=https://your-n8n-host/webhook/safari-chat
CHAT_TIMEOUT_MS=15000
