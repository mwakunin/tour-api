{
  "name": "footloose-adventures",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "description": "",
  "main": "index.js",
  "imports": {
    "#src/*": "./src/*",
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#utils/*": "./src/utils/*",
    "#validations/*": "./src/validations/*"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first --expose-gc --gc-interval=100 start.js",
    "start:prod": "NODE_ENV=production node --dns-result-order=ipv4first --expose-gc --gc-interval=100 start.js",
    "dev": "node --dns-result-order=ipv4first --watch --import ./src/instrument.js src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{js,json,md}\" --ignore-path .gitignore",
    "lint:all": "pnpm run lint && pnpm run format:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "NODE_ENV=test drizzle-kit migrate",
    "db:migrate:production": "NODE_ENV=production drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "dev:docker": "sh ./scripts/dev.sh",
    "test": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --detectOpenHandles",
    "test:watch": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --watch --runInBand",
    "test:verbose": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --verbose",
    "test:debug": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --verbose --bail",
    "test:coverage": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest --coverage --runInBand --testTimeout=120000",
    "test:coverage:summary": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --coverage --coverageReporters=text-summary --runInBand",
    "test:coverage:html": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --coverage --runInBand && xdg-open coverage/lcov-report/index.html",
    "test:destinations": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/destinations.test.js --runInBand",
    "test:bookings": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/bookings.test.js --runInBand",
    "test:auth": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/auth.test.js --runInBand",
    "test:users": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/users.test.js --runInBand",
    "test:tours": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/tours.test.js --runInBand",
    "test:payments": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/payments.test.js --runInBand",
    "test:emails": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/emails.test.js --runInBand",
    "test:uploads": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration/uploads.test.js --runInBand",
    "test:unit": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/unit --runInBand",
    "test:unit:validations": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/unit/validations.test.js --runInBand",
    "test:unit:middleware": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/unit/middleware.test.js --runInBand",
    "test:unit:utils": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/unit/utils.test.js --runInBand",
    "test:integration": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest src/__tests__/integration --runInBand",
    "prepare": "husky || true",
    "db:app-role": "node scripts/setup-app-role.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arcjet/inspect": "^1.0.0-beta.11",
    "@arcjet/node": "^1.0.0-beta.11",
    "@imagekit/nodejs": "^7.9.0",
    "@neondatabase/serverless": "^1.0.1",
    "@sentry/node": "^10.21.0",
    "@sentry/profiling-node": "^10.21.0",
    "axios": "^1.12.2",
    "better-auth": "^1.6.23",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "flutterwave-node-v3": "^1.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "paystack": "^2.0.1",
    "postgres": "^3.4.7",
    "resend": "^6.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "cookie-signature": "^1.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  }
}
